# Application Port
PORT=5000

# MongoDB URI (Replace with your actual MongoDB connection string)
MONGO_URI=mongodb://localhost:27017/careerpilot

# JWT Secret for authenticating users (Must be a secure random string in production)
JWT_SECRET=your_secure_random_jwt_secret_here

# Google Gemini API Key (Required for AI Agents: Analyzer and Advisor)
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith Configuration (Optional, for LangGraph tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=careerpilot

# Adzuna API Keys (Optional, for Job Matches integration)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
